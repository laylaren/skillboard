{
  "name": "@one-skill/server",
  "version": "0.1.0",
  "description": "Fastify backend for one-skill: REST API + static SPA host.",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/<your-github>/one-skill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-github>/one-skill.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/<your-github>/one-skill/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
