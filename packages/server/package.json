    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"const f=require('node:fs');f.rmSync('web-dist',{recursive:true,force:true});f.cpSync('../web/dist','web-dist',{recursive:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@one-skill/core": "^0.1.0",
