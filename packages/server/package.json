{
  "name": "@ai-skillboard/server",
  "version": "0.1.0",
  "description": "Fastify backend for skillboard: REST API + static SPA host.",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/laylaren/skillboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laylaren/skillboard.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/laylaren/skillboard/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "openclaw",
    "skills",
    "agent",
    "fastify"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "web-dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"const f=require('node:fs');f.copyFileSync('../../README.md','README.md');f.copyFileSync('../../LICENSE','LICENSE');f.rmSync('web-dist',{recursive:true,force:true});f.cpSync('../web/dist','web-dist',{recursive:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@ai-skillboard/core": "^0.1.0",
    "fastify": "^5.2.0"
  }
}
